function scrollToSection(id: string, close?: () => void) {
  const el = document.getElementById(id);
  if (el) {
    window.scrollTo({
      top: el.getBoundingClientRect().top + window.scrollY - SCROLL_OFFSET,
      behavior: "smooth",
    });
    trackEvent("navigation_click", { section: id });
  }
  close?.();
}

