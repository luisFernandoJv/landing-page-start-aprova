/* ============================================================
   Navegação, CTA e transições — refinamento visual (v2)
   Mantém a paleta: creme #F5F1E8, azul #1A3FA0, âmbar #FFBE0B, marrom #2A2312
   ============================================================ */

/* Header agora fixo (antes sumia ao rolar por ser position:absolute) */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 500;
  height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: min(1280px, calc(100% - 48px));
  margin: auto;
  background: transparent;
  border-bottom: 1px solid transparent;
  transition:
    background-color 0.4s ease,
    border-color 0.4s ease,
    box-shadow 0.4s ease,
    backdrop-filter 0.4s ease,
    height 0.3s ease;
}
.nav.nav-scrolled {
  background: rgba(245, 241, 232, 0.86);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom-color: rgba(42, 35, 18, 0.08);
  box-shadow: 0 12px 32px rgba(42, 35, 18, 0.08);
  height: 70px;
  width: 100%;
  left: 0;
  right: 0;
  padding: 0 max(24px, calc((100% - 1280px) / 2));
}
.scroll-progress {
  position: absolute;
  left: 0;
  bottom: -1px;
  height: 2px;
  background: linear-gradient(90deg, #1a3fa0, #ffbe0b);
  border-radius: 0 2px 2px 0;
  transform-origin: left;
}

/* Links de navegação — desktop */
.nav-links-desktop {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
}
.nav-link {
  position: relative;
  display: flex;
  align-items: center;
  padding: 9px 16px;
  color: #2a2312;
  opacity: 0.72;
  transition:
    opacity 0.2s ease,
    color 0.2s ease;
}
.nav-link:hover {
  opacity: 1;
}
.nav-link.active {
  opacity: 1;
  color: #1a3fa0;
}
.nav-pill {
  position: absolute;
  inset: 0;
  background: rgba(26, 63, 160, 0.1);
  border-radius: 999px;
  z-index: -1;
}
.nav-links-desktop .cta {
  margin-left: 14px;
}

/* Botão "Entrar" — área do aluno (desktop, dentro dos links de nav) */
.nav-login {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 9px 18px;
  margin-left: 6px;
  border-radius: 999px;
  border: 1.5px solid rgba(26, 63, 160, 0.3);
  color: #1a3fa0;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}
.nav-login:hover {
  background: rgba(26, 63, 160, 0.08);
  border-color: rgba(26, 63, 160, 0.55);
  transform: translateY(-1px);
}
.nav-login svg {
  width: 16px;
  height: 16px;
}

/* Agrupa hambúrguer + botão de login compacto no mobile */
.nav-actions-mobile {
  display: none;
  align-items: center;
  gap: 8px;
}

/* Botão "Entrar" compacto (ícone), visível só no mobile ao lado do hambúrguer */
.nav-login-mobile {
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border: 1.5px solid rgba(42, 35, 18, 0.16);
  background: rgba(42, 35, 18, 0.04);
  color: #2a2312;
  transition:
    background 0.2s ease,
    border-color 0.2s ease;
}
.nav-login-mobile:hover {
  background: rgba(42, 35, 18, 0.09);
}
.nav-login-mobile svg {
  width: 18px;
  height: 18px;
}

/* Botão do menu mobile */
.menu-button {
  display: none;
  border: 0;
  background: rgba(42, 35, 18, 0.06);
  color: #2a2312;
  width: 40px;
  height: 40px;
  padding: 0;
  border-radius: 999px;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease;
}
.menu-button:hover {
  background: rgba(42, 35, 18, 0.12);
}

/* Drawer mobile animado */
.nav-overlay {
  position: fixed;
  inset: 0;
  background: rgba(20, 17, 9, 0.42);
  backdrop-filter: blur(2px);
  z-index: 550;
}
.nav-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(86vw, 360px);
  z-index: 560;
  background: #f5f1e8;
  box-shadow: -24px 0 60px rgba(42, 35, 18, 0.22);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 104px 22px 32px;
}
.nav-drawer-links {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.nav-drawer-link {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 14px;
  border-radius: 14px;
  font-weight: 700;
  font-size: 15px;
  color: #2a2312;
  opacity: 0.82;
  transition:
    background 0.2s ease,
    opacity 0.2s ease;
}
.nav-drawer-link svg {
  width: 18px;
  color: #1a3fa0;
}
.nav-drawer-link:hover {
  background: rgba(26, 63, 160, 0.06);
  opacity: 1;
}
.nav-drawer-link.active {
  background: rgba(26, 63, 160, 0.09);
  opacity: 1;
  color: #1a3fa0;
}
.nav-drawer-link.active svg {
  color: #1a3fa0;
}
.nav-drawer .cta {
  width: 100%;
}
.nav-drawer-login {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-top: 10px;
  padding: 13px 16px;
  border-radius: 14px;
  border: 1.5px solid rgba(26, 63, 160, 0.35);
  color: #1a3fa0;
  font-weight: 700;
  font-size: 14px;
  transition:
    background 0.2s ease,
    border-color 0.2s ease;
}
.nav-drawer-login:hover {
  background: rgba(26, 63, 160, 0.07);
}
.nav-drawer-login svg {
  width: 17px;
}

/* CTA refinado: brilho sutil no hover, sem exagero */
.cta {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}
.cta-shine {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    115deg,
    transparent 30%,
    rgba(255, 255, 255, 0.55) 50%,
    transparent 70%
  );
  transform: translateX(-120%);
  transition: transform 0.7s ease;
  z-index: -1;
}
.cta:hover .cta-shine {
  transform: translateX(120%);
}
.cta-arrow {
  transition: transform 0.25s ease;
}
.cta:hover .cta-arrow {
  transform: translateX(3px);
}
.cta:focus-visible {
  outline: 2px solid #1a3fa0;
  outline-offset: 3px;
}

@media (max-width: 900px) {
  .nav {
    padding: 0 16px;
    width: 100%;
  }
  .nav-links-desktop {
    display: none;
  }
  .nav-actions-mobile {
    display: flex;
  }
  .nav-login-mobile {
    display: flex;
  }
  .menu-button {
    display: flex;
  }
}
@media (min-width: 901px) {
  .nav-overlay,
  .nav-drawer {
    display: none;
  }
}

/* Telas bem pequenas (iPhone SE e afins) — header mais enxuto */
@media (max-width: 380px) {
  .nav,
  .nav.nav-scrolled {
    padding: 0 12px;
    height: 66px;
  }
  .brand img {
    width: 108px;
  }
  .nav-actions-mobile {
    gap: 6px;
  }
  .nav-login-mobile,
  .menu-button {
    width: 36px;
    height: 36px;
  }
  .nav-drawer {
    width: 100vw;
    padding: 92px 18px 24px;
  }
}

/* Telas grandes — mais respiro nos links sem esticar demais o botão de login */
@media (min-width: 1400px) {
  .nav {
    width: min(1320px, calc(100% - 64px));
  }
  .nav.nav-scrolled {
    padding: 0 max(24px, calc((100% - 1320px) / 2));
  }
}
@media (prefers-reduced-motion: reduce) {
  .cta-shine {
    display: none;
  }
  .scroll-progress {
    transition: none;
  }
}

