    border-color 0.35s ease,
    background-color 0.35s ease,
    box-shadow 0.35s ease;
}
.authority-card:hover,
.authority-card:focus-visible {
  transform: translateY(-4px);
  border-color: rgba(255, 190, 11, 0.55);
  background: rgba(255, 255, 255, 0.05);
  box-shadow: 0 16px 34px rgba(10, 20, 60, 0.22);
  outline: none;
}
.authority-card svg {
  color: #ffbe0b;
  margin-bottom: 34px;
  transition: transform 0.35s ease;
}
.authority-card:hover svg,
.authority-card:focus-visible svg {
  transform: scale(1.1) rotate(-4deg);
}
.authority-card h3 {
  font-size: 17px;
  margin: 0 0 9px;
}
.authority-card p {
  font-size: 13px;
  line-height: 1.55;
  color: #cbd5ef;
