<file path="styles/globals.css">
/* ============================================================
   START APROVAÇÃO — Design System
   Luxury Dark + Amber/Orange authority palette
   ============================================================ */

@import url("https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap");

/* ── Tokens ── */
:root {
  /* Brand Colors */
  --amber: 36 100% 54%;
  --amber-light: 42 100% 65%;
  --amber-dark: 28 100% 42%;
  --amber-glow: 36 100% 54%;

  /* Neutrals */
  --bg: 220 18% 6%;
  --bg-card: 220 14% 9%;
  --bg-elevated: 220 12% 12%;
  --border: 220 10% 16%;
  --border-light: 220 10% 22%;

  /* Foreground */
  --fg: 220 15% 96%;
  --fg-muted: 220 10% 58%;
  --fg-subtle: 220 8% 38%;

  /* Semantic */
  --success: 145 60% 45%;
  --whatsapp: 142 70% 45%;
  --blue: 213 90% 60%;

  /* Spacing scale */
  --section-gap: 5rem;
  --card-radius: 1rem;
  --card-radius-lg: 1.5rem;

  /* Font */
  --font-display: "Syne", sans-serif;
  --font-body: "Inter", sans-serif;
}

/* ── Reset & Base ── */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-body);
  background-color: hsl(var(--bg));
  color: hsl(var(--fg));
  line-height: 1.6;
  overflow-x: hidden;
}

/* ── Typography ── */
h1,
h2,
h3,
h4 {
  font-family: var(--font-display);
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: -0.02em;
}

/* ── Utility Classes ── */
.gradient-text {
  background: linear-gradient(
    135deg,
    hsl(var(--amber)) 0%,
    hsl(var(--amber-light)) 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.card {
  background: hsl(var(--bg-card));
  border: 1px solid hsl(var(--border));
  border-radius: var(--card-radius);
  transition:
    border-color 0.2s,
    transform 0.2s;
}

.card:hover {
  border-color: hsl(var(--border-light));
}

.card-elevated {
  background: hsl(var(--bg-elevated));
  border: 1px solid hsl(var(--border-light));
  border-radius: var(--card-radius);
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.3rem 0.85rem;
  border-radius: 100px;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: hsla(var(--amber), 0.1);
  border: 1px solid hsla(var(--amber), 0.25);
  color: hsl(var(--amber));
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.875rem 1.75rem;
  background: linear-gradient(
    135deg,
    hsl(var(--amber)) 0%,
    hsl(var(--amber-dark)) 100%
  );
  color: #0a0a0a;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.95rem;
  border-radius: 0.75rem;
  border: none;
  cursor: pointer;
  text-decoration: none;
  transition:
    transform 0.15s,
    box-shadow 0.15s,
    filter 0.15s;
  box-shadow:
    0 0 0 0 hsla(var(--amber), 0.4),
    0 4px 20px hsla(var(--amber), 0.2);
  position: relative;
  overflow: hidden;
}

.btn-primary::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.15) 0%,
    transparent 60%
  );
  opacity: 0;
  transition: opacity 0.2s;
}

.btn-primary:hover {
  transform: translateY(-2px);
  filter: brightness(1.05);
  box-shadow:
    0 0 0 4px hsla(var(--amber), 0.15),
    0 8px 30px hsla(var(--amber), 0.35);
}

.btn-primary:hover::before {
  opacity: 1;
}
.btn-primary:active {
  transform: translateY(0);
}

.btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.875rem 1.75rem;
  background: transparent;
  color: hsl(var(--fg));
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.95rem;
  border-radius: 0.75rem;
  border: 1px solid hsl(var(--border-light));
  cursor: pointer;
  text-decoration: none;
  transition:
    border-color 0.2s,
    background 0.2s,
    transform 0.15s;
}

.btn-outline:hover {
  border-color: hsl(var(--amber));
  background: hsla(var(--amber), 0.06);
  transform: translateY(-2px);
}

.btn-whatsapp {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.875rem 1.75rem;
  background: linear-gradient(
    135deg,
    hsl(var(--whatsapp)) 0%,
    hsl(145, 70%, 35%) 100%
  );
  color: #fff;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.95rem;
  border-radius: 0.75rem;
  border: none;
  cursor: pointer;
  text-decoration: none;
  transition:
    transform 0.15s,
    filter 0.15s;
}

.btn-whatsapp:hover {
  transform: translateY(-2px);
  filter: brightness(1.08);
}

/* ── Divider ── */
.section-divider {
  width: 3rem;
  height: 3px;
  background: linear-gradient(90deg, hsl(var(--amber)), transparent);
  border-radius: 2px;
  margin-bottom: 1.5rem;
}

/* ── Background ── */
.bg-noise {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  opacity: 0.025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
}

/* ── Scrollbar ── */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: hsl(var(--bg));
}
::-webkit-scrollbar-thumb {
  background: hsl(var(--border-light));
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: hsl(var(--fg-subtle));
}

/* ── Selection ── */
::selection {
  background: hsla(var(--amber), 0.25);
  color: hsl(var(--fg));
}
