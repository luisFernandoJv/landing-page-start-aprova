}
.gallery-section {
  padding: 125px 0;
}
.gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 180px;
  gap: 12px;
  margin-top: 48px;
}
.gallery-item {
