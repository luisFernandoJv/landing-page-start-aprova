  margin: 18px 0 6px;
}
.teacher-name {
  font-family: "Manrope", sans-serif;
  font-size: 19px;
  font-weight: 700;
  color: #2a2312;
  margin: 0;
}
.teacher-name em {
  font-style: normal;
  color: #1a3fa0;
}
.teacher-more {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 14px;
  padding: 9px 18px;
  border-radius: 999px;
  background: #f2ecdd;
  color: #2a2312 !important;
  font-size: 12px;
  font-weight: 700;
  transition:
    background 0.2s,
    transform 0.2s;
}
.teacher-more svg {
  width: 14px;
  transition: transform 0.2s;
}
.teacher-card:hover .teacher-more {
  background: #ffbe0b;
  transform: translateY(-1px);
}
.teacher-card:hover .teacher-more svg {
  transform: translateX(3px);
}

@media (max-width: 900px) {
  .teacher-grid {
    grid-template-columns: 1fr;
    gap: 20px;
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
  }
}

/* ── Página de perfil do professor ───────────────────────────────────── */
.teacher-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
.teacher-profile {
  flex: 1;
  padding: 152px 0 96px;
}
.teacher-profile-grid {
  display: grid;
  grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
  gap: 56px;
  align-items: start;
  margin-top: 28px;
}
.teacher-profile-photo {
  border-radius: 24px;
  overflow: hidden;
  aspect-ratio: 900/950;
  background: #f2ecdd;
  box-shadow: 0 20px 48px rgba(42, 35, 18, 0.12);
  position: sticky;
  top: 112px;
}
.teacher-profile-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.teacher-profile-info h1 {
  font-family: "Manrope", sans-serif;
  font-size: clamp(30px, 4vw, 42px);
  font-weight: 800;
  margin: 10px 0 6px;
}
.teacher-profile-info h1 em {
  font-style: normal;
  color: #1a3fa0;
}
.teacher-profile-subject {
  font-size: 15px;
  font-weight: 700;
  color: #b8890a;
  margin-bottom: 20px;
}
.teacher-profile-formation {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 14px;
  background: #f2ecdd;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 24px;
}
.teacher-profile-formation svg {
  width: 18px;
  height: 18px;
  color: #1a3fa0;
  flex-shrink: 0;
}
.teacher-profile-bio {
  font-size: 15px;
  line-height: 1.75;
  opacity: 0.85;
  margin-bottom: 14px;
}
.teacher-profile-highlights {
  margin: 28px 0 32px;
  padding: 22px 24px;
  border-radius: 18px;
  border: 1px solid #e7e0cf;
}
.teacher-profile-highlights-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #2a2312;
  margin-bottom: 14px;
}
.teacher-profile-highlights-title svg {
  width: 15px;
  color: #b8890a;
}
.teacher-profile-highlights ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 10px;
}
.teacher-profile-highlights li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 600;
}
.teacher-profile-highlights li svg {
  width: 16px;
  color: #1a3fa0;
  flex-shrink: 0;
}
.teacher-profile-others {
  margin-top: 88px;
  padding-top: 48px;
  border-top: 1px solid #e7e0cf;
}
.teacher-profile-others-title {
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #766f61;
  margin-bottom: 20px;
}
.teacher-profile-others-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
.teacher-profile-other-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px;
  border-radius: 16px;
  border: 1px solid #e7e0cf;
  background: #fff;
  transition:
    transform 0.2s,
    box-shadow 0.2s;
}
.teacher-profile-other-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 32px rgba(42, 35, 18, 0.08);
}
.teacher-profile-other-card img {
  width: 56px;
  height: 56px;
  border-radius: 12px;
  object-fit: cover;
  flex-shrink: 0;
}
.teacher-profile-other-card > div {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.teacher-profile-other-subject {
  font-size: 11px;
  font-weight: 700;
  color: #766f61;
}
.teacher-profile-other-name {
  font-family: "Manrope", sans-serif;
  font-size: 15px;
  font-weight: 700;
}
.teacher-profile-other-name em {
  font-style: normal;
  color: #1a3fa0;
}
.teacher-profile-other-card > svg {
  width: 16px;
  opacity: 0.5;
  flex-shrink: 0;
}

@media (max-width: 860px) {
  .teacher-profile-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .teacher-profile-photo {
    position: static;
    max-width: 280px;
    margin: 0 auto;
  }
  .teacher-profile-others-grid {
    grid-template-columns: 1fr;
  }
}

/* ============================================================
   Rodapé — versão refinada e definitiva (v4)
   ============================================================ */
footer {
  background: #0e1f4d !important;
  background-image: linear-gradient(
    180deg,
    #13296b 0%,
    #0a1638 100%
  ) !important;
  color: #f5f1e8;
  padding: 0 !important;
  margin-top: 0 !important;
  border-top: none !important;
  position: relative;
  overflow: hidden;
  isolation: isolate;
}
footer:before,
footer:after {
  content: none !important;
}
.footer-glow {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(
      480px circle at 8% 0%,
      rgba(255, 190, 11, 0.16),
      transparent 60%
    ),
    radial-gradient(
      560px circle at 96% 100%,
      rgba(90, 130, 240, 0.28),
      transparent 60%
    );
}
footer .section-wrap {
  position: relative;
  z-index: 1;
}

/* Faixa de chamada, no topo do rodapé */
.footer-cta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  flex-wrap: wrap;
  padding: 56px 0 44px;
  border-bottom: 1px solid rgba(245, 241, 232, 0.12);
}
.footer-cta-row .eyebrow {
  color: #ffbe0b;
  margin-bottom: 6px;
}
.footer-cta-row h3 {
  font-family: "Manrope", sans-serif;
  font-weight: 700;
  font-size: clamp(22px, 2.4vw, 30px);
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin: 0;
  color: #fff;
  max-width: 520px;
}

/* Colunas principais */
.footer-main {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 48px;
  padding: 52px 0 44px;
}
.footer-brand {
  max-width: 360px;
}
.footer-brand .footer-logo {
  width: 150px;
  height: auto;
  filter: none !important;
  margin-bottom: 18px;
  display: inline-block;
}
.footer-brand p {
  color: rgba(245, 241, 232, 0.66);
  line-height: 1.7;
  font-size: 14px;
  margin: 0 0 22px;
}
.footer-social {
  display: flex;
  gap: 10px;
}
.footer-social a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(245, 241, 232, 0.08);
  border: 1px solid rgba(245, 241, 232, 0.16);
  color: #f5f1e8;
  transition:
    background 0.2s ease,
    transform 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}
.footer-social a svg {
  width: 16px;
}
.footer-social a:hover {
  background: #ffbe0b;
  border-color: #ffbe0b;
  color: #17377f;
  transform: translateY(-2px);
}

.footer-col {
  display: flex;
  flex-direction: column;
  gap: 13px;
}
.footer-col strong {
  color: #ffbe0b;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 800;
  margin-bottom: 3px;
}
.footer-col a {
  display: flex;
  align-items: center;
  gap: 9px;
  color: rgba(245, 241, 232, 0.72);
  font-size: 14px;
  transition:
    color 0.2s ease,
    transform 0.2s ease;
}
.footer-col a svg {
  width: 15px;
  color: #ffbe0b;
  flex-shrink: 0;
}
.footer-col a:hover {
  color: #fff;
  transform: translateX(3px);
}

/* Barra inferior */
.footer-bottom {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  flex-wrap: wrap;
  gap: 14px;
  border-top: 1px solid rgba(245, 241, 232, 0.12) !important;
  padding: 22px 0 !important;
  color: rgba(245, 241, 232, 0.55) !important;
  font-size: 12.5px !important;
}
.footer-legal {
  display: flex;
  gap: 8px;
  align-items: center;
}
.footer-legal a {
  color: rgba(245, 241, 232, 0.55);
  transition: color 0.2s ease;
}
.footer-legal a:hover {
  color: #fff;
}
.footer-credit {
  color: rgba(245, 241, 232, 0.4);
}

/* ── Páginas legais (Termos de Uso / Política de Privacidade) ───────────── */
.legal-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
.legal-main {
  flex: 1;
  padding: 152px max(24px, calc((100% - 820px) / 2)) 96px;
}
.legal-main .eyebrow {
  color: #b8890a;
}
.legal-main h1 {
  font-family: "Manrope", sans-serif;
  font-size: clamp(30px, 4vw, 44px);
  font-weight: 800;
  line-height: 1.15;
  margin: 10px 0 8px;
}
.legal-updated {
  font-size: 13px;
  opacity: 0.6;
  margin-bottom: 40px;
}
.legal-main section {
  margin-bottom: 36px;
}
.legal-main h2 {
  font-family: "Manrope", sans-serif;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.legal-main h2 svg {
  width: 18px;
  height: 18px;
  color: #b8890a;
  flex-shrink: 0;
}
.legal-main p,
.legal-main li {
  font-size: 15px;
  line-height: 1.75;
  opacity: 0.85;
}
.legal-main p + p {
  margin-top: 12px;
}
.legal-main ul {
  margin: 12px 0 0;
  padding-left: 20px;
}
.legal-main li {
  margin-bottom: 8px;
}
.legal-main li::marker {
  color: #b8890a;
}
.legal-main strong {
  font-weight: 700;
  color: #2a2312;
}
.legal-main a.legal-link {
  color: #1a3fa0;
  font-weight: 600;
  text-decoration: underline;
}
.legal-note {
  margin-top: 48px;
  padding: 20px 22px;
  border-radius: 16px;
  background: rgba(255, 190, 11, 0.12);
  border: 1px solid rgba(255, 190, 11, 0.35);
  font-size: 13px;
  line-height: 1.6;
  opacity: 0.85;
}
.legal-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 28px;
  opacity: 0.7;
  transition: opacity 0.2s;
}
.legal-back:hover {
  opacity: 1;
}
.legal-back svg {
  width: 16px;
}
.footer-credit a {
  color: rgba(245, 241, 232, 0.7);
  font-weight: 600;
  transition: color 0.2s ease;
}
.footer-credit a:hover {
  color: #ffbe0b;
}
.footer-top {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: none;
  border: 1px solid rgba(245, 241, 232, 0.18);
  color: rgba(245, 241, 232, 0.75);
  font-size: 12px;
  font-weight: 700;
  padding: 9px 14px;
  border-radius: 999px;
  cursor: pointer;
  transition:
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}
.footer-top svg {
  width: 13px;
}
.footer-top:hover {
  background: rgba(245, 241, 232, 0.1);
  color: #fff;
  border-color: rgba(245, 241, 232, 0.34);
}

@media (max-width: 900px) {
  .footer-main {
    grid-template-columns: 1fr 1fr;
    gap: 32px 28px;
  }
  .footer-brand {
    grid-column: 1/-1;
    max-width: none;
  }
  .footer-cta-row {
    padding: 48px 0 36px;
  }
}
@media (max-width: 600px) {
  .footer-cta-row {
    flex-direction: column;
    align-items: flex-start;
    padding: 44px 0 32px;
  }
  .footer-cta-row .cta {
    width: 100%;
  }
  .footer-main {
    grid-template-columns: 1fr;
    gap: 30px;
    padding: 40px 0 32px;
  }
  .footer-bottom {
    flex-direction: column !important;
    align-items: flex-start !important;
    padding: 22px 0 28px !important;
  }
}

/* ============================================================
   Área do Aluno — Login (CPF + senha)
   Painel dividido: identidade visual à esquerda, formulário à
   direita. No mobile, o painel visual some e o formulário assume
   a tela inteira. Sem <Navigation>/<Footer> de propósito — tela de
   autenticação funciona melhor sem distrações de navegação.
   ============================================================ */
.login-page {
  min-height: 100vh;
  background: #f5f1e8;
}
.login-grid {
  min-height: 100vh;
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
}

/* ── Painel visual ── */
.login-visual {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  background: #1a3fa0;
  background-image: linear-gradient(160deg, #1e46b5 0%, #13296b 100%);
  color: #fff;
  padding: 48px 56px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.login-visual-glow {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(
      520px circle at 8% 4%,
      rgba(255, 190, 11, 0.16),
      transparent 60%
    ),
    radial-gradient(
      620px circle at 100% 100%,
      rgba(120, 155, 255, 0.24),
      transparent 60%
    );
}
.login-visual > * {
  position: relative;
  z-index: 1;
}
.login-visual-brand {
  display: inline-flex;
  align-self: flex-start;
  transition: transform 0.3s ease;
}
.login-visual-brand:hover {
  transform: translateY(-2px);
}
.login-visual-brand img {
  width: 148px;
  display: block;
  filter: drop-shadow(0 10px 22px rgba(5, 12, 40, 0.35));
}
.login-visual-content .eyebrow {
  color: #ffbe0b;
}
.login-visual-content h2 {
  font-family: "Manrope", sans-serif;
  font-size: clamp(28px, 3vw, 40px);
  line-height: 1.12;
  letter-spacing: -0.03em;
  margin: 0 0 32px;
  max-width: 460px;
}
.login-benefits {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.login-benefits li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
  font-weight: 500;
  color: #dfe6f8;
}
.login-benefits svg {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  padding: 4px;
  border-radius: 50%;
  background: rgba(255, 190, 11, 0.16);
  color: #ffbe0b;
  box-sizing: content-box;
}
.login-visual-quote {
  max-width: 420px;
  font-size: 14px;
  line-height: 1.6;
  font-style: italic;
  color: #cbd5ef;
  padding-top: 24px;
  border-top: 1px solid rgba(245, 241, 232, 0.16);
}
.login-visual-quote-mark {
  display: block;
  font-family: "Manrope", sans-serif;
  font-style: normal;
  font-size: 34px;
  line-height: 1;
  color: #ffbe0b;
  margin-bottom: 4px;
}

/* ── Painel de formulário ── */
.login-form-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 24px;
}
.login-card {
  width: 100%;
  max-width: 408px;
  padding: 36px;
  border-radius: 28px;
  background: #fff;
  border: 1px solid rgba(42, 35, 18, 0.06);
  box-shadow: 0 30px 70px -20px rgba(42, 35, 18, 0.14);
}
.login-mobile-brand {
  display: none;
}
.login-card .eyebrow {
  margin-bottom: 10px;
}
.login-card h1 {
  font-family: "Manrope", sans-serif;
  font-size: clamp(28px, 4vw, 34px);
  letter-spacing: -0.03em;
  margin: 0 0 10px;
  color: #2a2312;
}
.login-subtitle {
  font-size: 14px;
  line-height: 1.6;
  color: #766f61;
  margin: 0 0 32px;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.login-field label {
  display: block;
  font-size: 12.5px;
  font-weight: 700;
  color: #2a2312;
  margin-bottom: 7px;
  letter-spacing: 0.01em;
}
.login-input-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1.5px solid #ece5d4;
  background: #faf8f2;
  border-radius: 16px;
  padding: 0 15px;
  transition:
    border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
    box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
    background-color 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.login-input-wrap:hover {
  border-color: #ddd2b7;
}
.login-input-wrap:focus-within {
  border-color: #1a3fa0;
  background: #fff;
  box-shadow: 0 0 0 4.5px rgba(26, 63, 160, 0.09);
}
.login-input-wrap svg {
  width: 17px;
  height: 17px;
  color: #b5ab94;
  flex-shrink: 0;
  transition: color 0.3s ease;
}
.login-input-wrap:focus-within svg {
  color: #1a3fa0;
}
.login-input-wrap input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: none;
  background: transparent;
  padding: 14.5px 2px;
  font: inherit;
  font-size: 14.5px;
  color: #2a2312;
  transition: color 0.2s ease;
}
.login-input-wrap input::placeholder {
  color: #c2b8a0;
}
/* Neutraliza o preenchimento automático azul do navegador, mantendo o
   fundo do campo consistente com o resto do formulário. */
.login-input-wrap input:-webkit-autofill,
.login-input-wrap input:-webkit-autofill:hover,
.login-input-wrap input:-webkit-autofill:focus {
  -webkit-text-fill-color: #2a2312;
  -webkit-box-shadow: 0 0 0px 1000px #faf8f2 inset;
  box-shadow: 0 0 0px 1000px #faf8f2 inset;
  transition: background-color 9999s ease-in-out 0s;
  caret-color: #2a2312;
}
.login-input-wrap:focus-within input:-webkit-autofill {
  -webkit-box-shadow: 0 0 0px 1000px #fff inset;
  box-shadow: 0 0 0px 1000px #fff inset;
}
.login-toggle-visibility {
  border: 0;
  background: none;
  border-radius: 50%;
  padding: 7px;
  margin: 0 -6px 0 0;
  display: flex;
  color: #a89d86;
  cursor: pointer;
  transition:
    color 0.2s ease,
    background-color 0.2s ease;
}
.login-toggle-visibility:hover {
  color: #2a2312;
  background: rgba(42, 35, 18, 0.06);
}
.login-toggle-visibility svg {
  width: 17px;
  height: 17px;
}
.login-input-error {
  border-color: rgba(209, 73, 58, 0.45) !important;
  background: rgba(209, 73, 58, 0.04) !important;
}
.login-input-error:focus-within {
  box-shadow: 0 0 0 4.5px rgba(209, 73, 58, 0.1) !important;
}
.login-input-error svg {
  color: #c1483a !important;
}
.login-error-msg {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: -8px 0 0;
  font-size: 12.5px;
  font-weight: 600;
  color: #b8382b;
  animation: login-error-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes login-error-in {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.login-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
.login-checkbox {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 13px;
  font-weight: 600;
  color: #665f50;
  cursor: pointer;
  user-select: none;
}
.login-checkbox input {
  position: absolute;
  opacity: 0;
  width: 1px;
  height: 1px;
}
.login-checkbox-box {
  width: 18px;
  height: 18px;
  border-radius: 6px;
  border: 1.5px solid #d8cfb8;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease;
}
.login-checkbox-box svg {
  width: 12px;
  height: 12px;
  color: #fff;
  opacity: 0;
  transition: opacity 0.15s ease;
}
.login-checkbox input:checked + .login-checkbox-box {
  background: #1a3fa0;
  border-color: #1a3fa0;
}
.login-checkbox input:checked + .login-checkbox-box svg {
  opacity: 1;
}
.login-checkbox input:focus-visible + .login-checkbox-box {
  outline: 2px solid #1a3fa0;
  outline-offset: 2px;
}
.login-forgot {
  font-size: 13px;
  font-weight: 700;
  color: #1a3fa0;
  transition: opacity 0.2s ease;
}
.login-forgot:hover {
  opacity: 0.75;
}

.login-submit {
  margin-top: 8px;
  width: 100%;
  background: #ffbe0b;
  color: #2a2312;
  border: 0;
  border-radius: 999px;
  padding: 16px 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font: inherit;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.03em;
  cursor: pointer;
  box-shadow: 0 10px 24px -8px rgba(255, 190, 11, 0.55);
  transition:
    transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
    background-color 0.25s ease,
    box-shadow 0.3s ease,
    opacity 0.2s ease;
}
.login-submit:active:not(:disabled) {
  transform: translateY(0) scale(0.98);
}
.login-submit:hover:not(:disabled) {
  background: #ffc92f;
  transform: translateY(-2px);
}
.login-submit:disabled {
  opacity: 0.75;
  cursor: progress;
}
.login-submit svg {
  width: 17px;
  height: 17px;
}
.login-spinner {
  width: 15px;
  height: 15px;
  border-radius: 50%;
  border: 2px solid rgba(42, 35, 18, 0.28);
  border-top-color: #2a2312;
  animation: login-spin 0.7s linear infinite;
}
@keyframes login-spin {
  to {
    transform: rotate(360deg);
  }
}

.login-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 26px 0 18px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #a89d86;
}
.login-divider span {
  flex: 1;
  height: 1px;
  background: #e7e0cf;
}

.login-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 14px 16px;
  border-radius: 999px;
  border: 1.5px solid rgba(26, 63, 160, 0.24);
  color: #1a3fa0;
  font-size: 13.5px;
  font-weight: 700;
  transition:
    background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
    border-color 0.3s ease,
    transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
    gap 0.3s ease;
}
.login-secondary:hover svg {
  transform: translateX(2px);
}
.login-secondary svg {
  transition: transform 0.25s ease;
}
.login-secondary:hover {
  background: rgba(26, 63, 160, 0.06);
  border-color: rgba(26, 63, 160, 0.5);
  transform: translateY(-1px);
}
.login-secondary svg {
  width: 15px;
  height: 15px;
}

.login-security-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin: 28px 0 0;
  font-size: 11.5px;
  color: #948c7a;
  text-align: center;
}
.login-security-note svg {
  width: 14px;
  height: 14px;
  color: #6a9b6f;
  flex-shrink: 0;
}

/* Tablet: painel visual continua, mas com menos respiro */
@media (max-width: 1100px) and (min-width: 901px) {
  .login-visual {
    padding: 40px;
  }
  .login-form-panel {
    padding: 40px 32px;
  }
}

@media (max-width: 900px) {
  .login-grid {
    grid-template-columns: 1fr;
  }
  .login-visual {
    display: none;
  }
  .login-mobile-brand {
    display: inline-flex;
    margin-bottom: 28px;
  }
  .login-mobile-brand img {
    width: 138px;
    filter: none;
  }
  .login-form-panel {
    padding: 40px 20px 56px;
    align-items: flex-start;
  }
  .login-card {
    max-width: 440px;
    margin: 0 auto;
  }
}
@media (max-width: 480px) {
  .login-card {
    padding: 28px 22px;
    border-radius: 22px;
  }
  .login-row {
    gap: 14px;
  }
}
@media (max-width: 380px) {
  .login-card {
    padding: 24px 18px;
  }
  .login-card h1 {
    font-size: 25px;
  }
  .login-visual-content h2 {
    font-size: 26px;
  }
}
@media (max-height: 720px) and (min-width: 901px) {
  .login-visual {
    padding: 32px 48px;
  }
  .login-visual-content h2 {
    margin-bottom: 20px;
  }
  .login-benefits {
    gap: 10px;
  }
}
</file>

<file path="src/components/AboutSection.tsx">
import { useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import {
  CheckCircle,
  BrainCircuit,
  Target,
  Trophy,
  Search,
  BookOpenCheck,
  RefreshCw,
  Award,
} from "lucide-react";

const differentials = [
  "Engenharia reversa das principais bancas do país",
  "Ciclos de estudo e revisões espaçadas programadas",
  "Mentoria estratégica e acompanhamento de métricas",
  "Simulados com correção focada em pontos cegos",
  "Material focado no Princípio de Pareto — 80/20",
  "Ecossistema imersivo para blindagem emocional",
];

const pillars = [
  {
    icon: BrainCircuit,
    title: "Análise de Dados",
    desc: "Mapeamos o histórico de provas para entregar apenas o que cai.",
  },
  {
    icon: Target,
    title: "Tática de Prova",
    desc: "Aprenda a resolver questões com velocidade e precisão.",
  },
  {
    icon: CheckCircle,
    title: "Resultado Real",
    desc: "Metodologia validada por aprovados em todo o Brasil.",
  },
];

const steps = [
  {
    icon: Search,
    title: "Mapeamento da Banca",
    short: "Raio-X do histórico de provas",
    desc: "Cruzamos anos de provas anteriores da banca do seu concurso para identificar os temas que mais caem — e os que você pode ignorar com segurança.",
  },
  {
    icon: BookOpenCheck,
    title: "Material Cirúrgico",
    short: "Só o que cai, sem enrolação",
    desc: "Apostilas enxutas construídas com o Princípio de Pareto: 20% do conteúdo responsável por 80% dos pontos possíveis na prova.",
  },
  {
    icon: RefreshCw,
    title: "Ciclos de Revisão",
    short: "Repetição espaçada e programada",
    desc: "Cronograma de revisões e simulados calibrados no nível exato da banca, para fixar o conteúdo na memória de longo prazo.",
  },
  {
    icon: Award,
    title: "Prova & Aprovação",
    short: "Tática de resolução rápida",
    desc: "Você chega no dia sabendo exatamente o que esperar, com estratégia de tempo e resolução treinada até virar hábito.",
  },
];

const fade = {
  hidden: { opacity: 0, y: 20 },
  show: { opacity: 1, y: 0, transition: { duration: 0.5 } },
};

// ─── Sub-componente: Ciclo do Método (interativo) ─────────────────────────────
// Visualização prática do passo a passo — clique em cada etapa para ver o
// detalhe. A linha de progresso "desenha" suavemente ao entrar na tela e se
// atualiza ao trocar de etapa.
function MethodCycle() {
  const [active, setActive] = useState(0);
  const ActiveIcon = steps[active].icon;

  return (
    <motion.div
      initial={{ opacity: 0, y: 24 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94] }}
      className="mb-16 p-6 sm:p-10 lg:p-12 rounded-3xl bg-zinc-900/50 border border-zinc-800 backdrop-blur-sm relative overflow-hidden"
    >
      <div className="absolute -top-24 -left-24 w-64 h-64 bg-amber-500/5 blur-[90px] rounded-full pointer-events-none" />

      <div className="relative z-10 mb-10 lg:mb-14 text-center">
        <span className="text-xs font-bold uppercase tracking-widest text-amber-500">
          Passo a Passo
        </span>
        <h3 className="text-2xl sm:text-3xl font-extrabold text-white font-display mt-2">
          O ciclo do método, na prática
        </h3>
      </div>

      {/* Trilho de etapas */}
      <div className="relative z-10 flex items-start justify-between max-w-3xl mx-auto mb-10">
        {/* Linha base */}
        <div className="absolute top-6 left-0 right-0 h-[2px] bg-zinc-800 mx-6" />
        {/* Linha de progresso animada */}
        <motion.div
          className="absolute top-6 left-6 h-[2px] bg-gradient-to-r from-amber-400 to-orange-500 origin-left"
          initial={{ width: "0%" }}
          whileInView={{
            width: `calc(${(active / (steps.length - 1)) * 100}% - 3rem)`,
          }}
          animate={{
            width: `calc(${(active / (steps.length - 1)) * 100}% - 3rem)`,
          }}
          viewport={{ once: true }}
          transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94] }}
        />

        {steps.map((step, i) => {
          const StepIcon = step.icon;
          const isActive = i === active;
          const isDone = i < active;
          return (
            <button
              key={step.title}
              onClick={() => setActive(i)}
              aria-pressed={isActive}
              className="relative z-10 flex flex-col items-center gap-3 flex-1 group focus:outline-none"
            >
              <motion.span
                animate={{
                  scale: isActive ? 1.12 : 1,
                  backgroundColor:
                    isActive || isDone ? "rgb(245 158 11)" : "rgb(24 24 27)",
                  borderColor:
                    isActive || isDone ? "rgb(245 158 11)" : "rgb(63 63 70)",
                }}
                transition={{ duration: 0.3 }}
                className="w-12 h-12 rounded-full flex items-center justify-center border-2 shadow-lg"
              >
                <StepIcon
                  size={18}
                  className={
                    isActive || isDone
                      ? "text-zinc-950"
                      : "text-zinc-500 group-hover:text-zinc-300"
                  }
                />
              </motion.span>
              <span
                className={`hidden sm:block text-[11px] font-bold text-center leading-tight max-w-[7.5rem] transition-colors ${
                  isActive
                    ? "text-amber-500"
                    : "text-zinc-500 group-hover:text-zinc-300"
                }`}
              >
                {step.title}
              </span>
            </button>
          );
        })}
      </div>

      {/* Painel de detalhe da etapa ativa */}
      <div className="relative z-10 max-w-2xl mx-auto min-h-[9rem] sm:min-h-[7.5rem]">
        <AnimatePresence mode="wait">
          <motion.div
            key={active}
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -10 }}
            transition={{ duration: 0.3, ease: "easeOut" }}
            className="flex flex-col sm:flex-row items-center sm:items-start gap-5 p-6 rounded-2xl bg-zinc-950/60 border border-zinc-800/80 text-center sm:text-left"
          >
            <div className="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 bg-amber-500/10 border border-amber-500/20">
              <ActiveIcon size={20} className="text-amber-500" />
            </div>
            <div>
              <span className="block text-[11px] font-bold uppercase tracking-wider text-amber-500 mb-1">
                Etapa {active + 1} de {steps.length} — {steps[active].short}
              </span>
              <p className="text-sm sm:text-base text-zinc-300 leading-relaxed">
                {steps[active].desc}
              </p>
            </div>
          </motion.div>
        </AnimatePresence>
      </div>

      {/* Navegação simples entre etapas */}
      <div className="relative z-10 flex items-center justify-center gap-2 mt-6">
        {steps.map((_, i) => (
          <button
            key={i}
            onClick={() => setActive(i)}
            aria-label={`Ver etapa ${i + 1}`}
            className="h-1.5 rounded-full transition-all duration-300"
            style={{
              width: i === active ? "22px" : "7px",
              background:
                i === active ? "hsl(38,95%,54%)" : "rgba(255,255,255,0.15)",
            }}
          />
        ))}
      </div>
    </motion.div>
  );
}

export function AboutSection() {
  return (
    <section
      id="sobre"
      className="py-20 lg:py-28 px-4 sm:px-6 max-w-[1200px] mx-auto overflow-hidden"
    >
      {/* Header Padronizado com o Radar */}
      <motion.div
        initial="hidden"
        whileInView="show"
        viewport={{ once: true }}
        variants={fade}
        className="mb-14 lg:mb-20 text-center flex flex-col items-center"
      >
        <div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-zinc-300 text-[11px] font-bold uppercase tracking-wider mb-4 backdrop-blur-sm shadow-sm">
          <Trophy size={14} className="text-amber-500" />
          Arquitetura do Método
        </div>

        <h2 className="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-display mb-4">
          Por que somos a máquina de{" "}
          <span className="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-500">
            fazer aprovados?
          </span>
        </h2>
        <p className="text-zinc-400 max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
          Não acreditamos em força bruta. Acreditamos em análise de dados,
          inteligência emocional e tática de prova.
        </p>
      </motion.div>

      {/* Pillars */}
      <motion.div
        initial="hidden"
        whileInView="show"
        viewport={{ once: true }}
        variants={{
          hidden: {},
          show: { transition: { staggerChildren: 0.1 } },
        }}
        className="grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8 mb-16"
      >
        {pillars.map(({ icon: Icon, title, desc }) => (
          <motion.div
            key={title}
            variants={fade}
            className="p-8 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-amber-500/30 transition-colors backdrop-blur-sm flex flex-col items-center text-center group"
          >
            <div className="w-14 h-14 rounded-xl flex items-center justify-center mb-6 bg-amber-500/10 border border-amber-500/20 group-hover:scale-110 transition-transform duration-300">
              <Icon size={24} className="text-amber-500" />
            </div>
            <h3 className="text-xl font-bold text-white mb-3 font-display">
              {title}
            </h3>
            <p className="text-sm leading-relaxed text-zinc-400">{desc}</p>
          </motion.div>
        ))}
      </motion.div>

      {/* Ciclo do método — visual, interativo e prático */}
      <MethodCycle />

      {/* Differentials - Agora parece uma extensão limpa da UI */}
      <motion.div
        initial={{ opacity: 0, y: 24 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
        className="p-8 lg:p-12 rounded-3xl bg-zinc-900/60 border border-zinc-800 shadow-2xl relative overflow-hidden"
      >
        <div className="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 bg-amber-500/5 blur-[80px] rounded-full pointer-events-none" />

        <div className="flex items-center gap-2 mb-3 text-xs font-bold uppercase tracking-widest text-amber-500">
          Vantagem Competitiva
        </div>
        <p className="text-2xl sm:text-3xl font-extrabold text-white mb-8 font-display">
          O arsenal completo para sua aprovação
        </p>

        <ul className="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5">
          {differentials.map((item) => (
            <li key={item} className="flex items-start gap-3">
              <CheckCircle
                size={18}
                className="flex-shrink-0 mt-0.5 text-amber-500"
              />
              <span className="text-sm sm:text-base leading-relaxed text-zinc-300">
                {item}
              </span>
            </li>
          ))}
        </ul>
      </motion.div>
    </section>
  );
}
</file>

