}
.faq-item svg.rotate {
  transform: rotate(180deg);
}
.faq-item p {
  grid-column: 1/-1;
  color: #766f61;
  font-size: 14px;
  font-weight: 400;
  margin: 12px 0 0;
  line-height: 1.6;
}
footer {
  background: #2a2312;
  color: #f5f1e8;
  padding: 70px 0 22px;
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 30px;
}
.footer-logo {
  width: 150px;
  filter: brightness(0) invert(1);
  margin-bottom: 16px;
}
.footer-grid p {
  color: #b9b09f;
  font-size: 14px;
}
.footer-grid strong {
  display: block;
  color: #ffbe0b;
  font-size: 12px;
  letter-spacing: 0.12em;
  margin-bottom: 18px;
}
.footer-grid a {
  display: block;
  color: #cfc6b4;
  font-size: 14px;
  margin-bottom: 12px;
}
.footer-bottom {
  border-top: 1px solid #514936;
  margin-top: 55px;
  padding-top: 18px;
  color: #918874;
  font-size: 11px;
  display: flex;
  justify-content: space-between;
}
.materials-page {
  min-height: 100vh;
}
.materials {
  padding-top: 155px;
  padding-bottom: 110px;
}
.materials h1 {
  font-size: clamp(42px, 6vw, 72px);
  max-width: 850px;
}
.search-box {
  margin-top: 42px;
  max-width: 620px;
  background: #fff;
  border: 1px solid #d7cfbd;
  border-radius: 12px;
  display: flex;
  align-items: center;
  padding: 0 17px;
}
.search-box svg {
  width: 18px;
  color: #1a3fa0;
}
.search-box input {
  border: 0;
  outline: 0;
  background: none;
  padding: 17px 12px;
  width: 100%;
  font-size: 15px;
}
.filter-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin: 25px 0;
}
.filter-row button {
  border: 1px solid #d7cfbd;
  background: transparent;
  border-radius: 999px;
  padding: 10px 15px;
  font-size: 12px;
  cursor: pointer;
}
.filter-row button.active,
.filter-row button:hover {
  background: #1a3fa0;
  color: #fff;
  border-color: #1a3fa0;
}
@media (max-width: 800px) {
  .section-wrap {
    width: min(100% - 32px, 600px);
  }
  .brand img {
    width: 130px;
  }
  .hero {
    padding-top: 125px;
    grid-template-columns: 1fr;
    gap: 55px;
    min-height: 0;
  }
  .hero h1 {
    font-size: clamp(44px, 13vw, 64px);
  }
  .hero-actions {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
  }
  .faculty-board {
    box-shadow: 7px 9px 0 #ffbe0b;
  }
  .authority-grid {
    grid-template-columns: 1fr 1fr;
  }
  .blue-section,
  .cream-section {
    padding: 76px 0;
  }
  .timeline {
    flex-direction: column;
    margin-top: 48px;
    gap: 30px;
  }
  .timeline-track {
    top: 0;
    bottom: 0;
    left: 27px;
    right: auto;
    width: 2px;
    height: auto;
    background: linear-gradient(180deg, #1a3fa0, #ffbe0b);
  }
  .step {
    flex-direction: row;
    align-items: center;
    gap: 18px;
    padding-right: 0;
  }
  .step-body b,
  .step-body span {
    max-width: none;
  }
  .benefits,
  .offer,
  .faq {
    grid-template-columns: 1fr;
    gap: 30px;
    padding-top: 0;
  }
  /* A "Offer" (Comece Hoje) vem logo depois da seção azul de depoimentos —
     sem espaço próprio ela fica colada nela. Damos um respiro proporcional
     ao resto do site em vez de herdar o padding-top: 0 acima. */
  .offer {
    padding-top: 64px;
  }
  .benefit-feature {
    padding: 32px 25px;
  }
  .gallery-section {
    padding: 76px 0;
  }
  .gallery {
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 150px;
  }
  .gallery img:first-child {
    grid-row: span 1;
  }
  .gallery img:nth-child(4) {
    grid-column: span 1;
  }
  .proof-grid {
    columns: 2 180px;
    column-gap: 10px;
    margin-top: 36px;
  }
  .row-heading {
    display: block;
  }
  .row-heading .lead {
    margin-top: 20px;
  }
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
  .footer-grid > div:first-child {
    grid-column: 1/-1;
  }
  .footer-bottom {
    display: block;
    line-height: 1.7;
  }
  .footer-bottom span {
    display: block;
  }
  .materials {
    padding-top: 125px;
  }
  .materials h1 {
    font-size: clamp(42px, 12vw, 60px);
  }
}
@media (max-width: 430px) {
  .authority-grid {
    grid-template-columns: 1fr;
  }
  .photo-grid {
    grid-template-rows: 110px 110px;
  }
  .hero .lead {
    font-size: 16px;
  }
  .footer-grid {
    grid-template-columns: 1fr;
  }
  .footer-grid > div:first-child {
    grid-column: auto;
  }
}
.blue-section,
.cream-section {
  position: relative;
  isolation: isolate;
}
.blue-section {
  border-radius: 56px 56px 0 0;
  margin-top: -32px;
  padding-top: 32px;
  box-shadow: 0 -18px 42px rgba(26, 63, 160, 0.08);
}
.cream-section {
  border-radius: 48px 48px 0 0;
  margin-top: -24px;
  box-shadow: 0 -12px 32px rgba(42, 35, 18, 0.045);
}
.method,
.benefits,
.gallery-section,
.offer {
  position: relative;
}
.method:after,
.gallery-section:after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -1px;
  width: min(88%, 720px);
  height: 1px;
  transform: translateX(-50%);
  background: linear-gradient(
    90deg,
    transparent,
    rgba(26, 63, 160, 0.16),
    transparent
  );
}
.faculty-board {
  box-shadow: 0 24px 60px rgba(42, 35, 18, 0.18);
}
.photo-grid img {
  object-fit: cover;
  display: block;
}
.hero .photo-main {
  min-height: 300px;
  object-fit: cover;
}
.hero .faculty-board {
  width: 100%;
  max-width: 600px;
  justify-self: end;
}
.hero .photo-grid {
  min-width: 0;
}
.hero .photo-grid img {
  width: 100%;
  height: 100%;
}
@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    gap: 42px;
    min-height: auto;
