}
.timeline {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 76px;
}
.timeline-track {
  position: absolute;
  top: 28px;
  left: 28px;
  right: 28px;
  height: 2px;
  background: linear-gradient(90deg, #1a3fa0, #ffbe0b);
  opacity: 0.22;
  z-index: 0;
}
.step {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18px;
  padding-right: 12px;
}
.step-marker {
  position: relative;
  width: 56px;
  height: 56px;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f1e8;
  border: 1.5px solid #e4dcc9;
  color: #1a3fa0;
  box-shadow: 0 4px 14px rgba(42, 35, 18, 0.06);
  transition:
    transform 0.35s ease,
    background-color 0.35s ease,
    background-image 0.35s ease,
    border-color 0.35s ease,
    box-shadow 0.35s ease,
    color 0.35s ease;
}
.step-marker svg {
  width: 22px;
  height: 22px;
}
.step-number {
  position: absolute;
  top: -6px;
  right: -6px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #ffbe0b;
  color: #17377f;
  font-size: 10px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #f5f1e8;
  transition: transform 0.35s ease;
}
.step-body b {
  display: block;
  font-weight: 700;
  font-size: 15px;
  color: #2a2312;
  margin-bottom: 6px;
  max-width: 170px;
  transition: color 0.3s ease;
}
.step-body span {
  display: block;
  font-weight: 400;
  font-size: 13px;
  line-height: 1.55;
  color: #948c7a;
  max-width: 185px;
  transition: color 0.3s ease;
}
.step:focus-visible {
  outline: none;
}
.step:focus-visible .step-marker {
  box-shadow: 0 0 0 3px rgba(26, 63, 160, 0.25);
}
.step:hover .step-marker,
.step:focus-within .step-marker {
  transform: translateY(-4px) scale(1.06);
  background: linear-gradient(145deg, #1a3fa0, #17377f);
  border-color: #1a3fa0;
  color: #ffbe0b;
  box-shadow: 0 12px 26px rgba(26, 63, 160, 0.3);
}
.step:hover .step-number,
.step:focus-within .step-number {
  transform: scale(1.1);
}
.step:hover .step-body span,
.step:focus-within .step-body span {
  color: #4a4232;
}
.benefits {
  padding: 0 0 125px;
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 70px;
}
.benefit-feature {
  background: #ffbe0b;
  border-radius: 22px;
