  color: #1a3fa0;
  background: rgba(26, 63, 160, 0.1);
  border-radius: 50%;
}
.offer-card .cta {
  width: 100%;
}
.faq {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 80px;
}
.faq-item {
  width: 100%;
  background: none;
  border: 0;
  border-bottom: 1px solid #d7cfbd;
  padding: 21px 0;
