  flex-direction: column;
  gap: 13px;
}
.offer-points li {
  display: flex;
  align-items: center;
  gap: 11px;
  font-size: 14px;
  font-weight: 600;
  color: #4a4232;
}
.offer-points svg {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  color: #1a3fa0;
}
.offer-card {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border: 1px solid rgba(26, 63, 160, 0.12);
  border-radius: 24px;
  padding: 38px 34px;
  background: #fff;
  box-shadow: 0 24px 60px rgba(42, 35, 18, 0.1);
  transition:
    transform 0.4s ease,
    box-shadow 0.4s ease;
}
.offer-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 30px 70px rgba(26, 63, 160, 0.16);
}
.offer-card-glow {
  position: absolute;
  top: -70px;
  right: -70px;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255, 190, 11, 0.22),
    transparent 70%
  );
  z-index: -1;
  pointer-events: none;
}
.offer-card p {
  color: #1a3fa0;
  font-size: 11px;
  letter-spacing: 0.13em;
  font-weight: 800;
  margin: 0 0 10px;
}
.offer-card strong {
  display: block;
  font-family: "Manrope";
  font-size: 28px;
  letter-spacing: -0.02em;
}
.offer-card > span {
  display: block;
  color: #766f61;
  font-size: 14px;
  line-height: 1.55;
